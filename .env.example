# ===== Telegram API Kimlik Bilgileri =====
# https://my.telegram.org/apps adresinden alınır
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+905551234567

# ===== Hedef Kanallar (virgülle ayrılmış) =====
# Public: @kanaladi veya kanaladi
# Private: -1001234567890 (sayısal ID)
TARGET_CHANNELS=@channel1,@channel2,-1001234567890

# ===== Veri Dizini =====
DATA_DIR=./data

# ===== CLIP Model =====
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# ===== ChromaDB =====
CHROMA_COLLECTION=models_3d
CHROMA_DB_PATH=./data/chroma_db
