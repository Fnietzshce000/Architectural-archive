# ===== Telegram API Kimlik Bilgileri =====
# https://my.telegram.org adresinden alınır
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_PHONE=+905551234567

# ===== Hedef Kanallar =====
# Virgülle ayrılmış Telegram kanal listesi
TARGET_CHANNELS=@Free_3D_Collection,@model3dpro,@free_3ddd

# ===== Veri Dizini =====
DATA_DIR=./data

# ===== CLIP Model =====
# SigLIP 2 önerilir (en iyi sonuçlar)
CLIP_MODEL_NAME=hf-hub:timm/ViT-SO400M-14-SigLIP2
CLIP_PRETRAINED=

# ===== ChromaDB =====
CHROMA_COLLECTION=models_3d_siglip2
CHROMA_DB_PATH=./data/chroma_db

# ===== AI Models (LM Studio - Opsiyonel) =====
LLM_TEXT_MODEL=your-text-model
LLM_VISION_MODEL=your-vision-model

# ===== API Keys =====
# OpenAI (opsiyonel)
OPENAI_API_KEY=your_openai_key

# Gemini (sorgu genişletme için önerilir)
GEMINI_API_KEY=your_gemini_key

# ===== Telegram Bot (Opsiyonel) =====
# @BotFather'dan alınır
TELEGRAM_BOT_TOKEN=your_bot_token
